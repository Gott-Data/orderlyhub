# ─── Supabase (free tier) ───
# Get from: https://supabase.com → Project → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbG...your_service_role_key

# ─── WhatsApp Cloud API (Meta) ───
# Get from: https://developers.facebook.com → App → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=123456789012345
WA_ACCESS_TOKEN=EAAG...your_token
WA_VERIFY_TOKEN=orderlyhub_verify_2024

# ─── Team WhatsApp (receives notifications) ───
# Your team's WhatsApp number with country code, no + sign
TEAM_PHONE=23276123456

# ─── Admin Dashboard ───
# Any secret string. Admin sends this in x-admin-key header.
ADMIN_KEY=change-this-to-something-secret
